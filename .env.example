# RED Ultimate — Environment Configuration
# Copy this file to .env and customize for your deployment.

# ── JWT Authentication ──────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random secret (≥32 bytes) for production!
RED_JWT_SECRET=please-change-this-long-random-sovereign-secret-32b

# ── Bootstrap Admin ─────────────────────────────────────────────────────────
# The first admin user is created on first run with these credentials.
RED_ADMIN_EMAIL=admin@red.local
RED_ADMIN_PASSWORD=changeme123

# ── Network ─────────────────────────────────────────────────────────────────
# Public IP for the Media SFU (WebRTC). Required for VoIP calls.
PUBLIC_IP=127.0.0.1

# ── COTURN ──────────────────────────────────────────────────────────────────
# Secret for the TURN server (used for NAT traversal in VoIP).
TURN_SECRET=redturnsecret

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (users, metadata)
SPRING_DATASOURCE_URL=jdbc:postgresql://db-postgres:5432/red_sovereign
SPRING_DATASOURCE_USERNAME=red
SPRING_DATASOURCE_PASSWORD=password

# MongoDB (messages, stories, audit)
SPRING_DATA_MONGODB_URI=mongodb://db-mongo:27017/red_messages

# Redis (dedup, sequencing, presence, rate-limit)
SPRING_DATA_REDIS_HOST=cache-redis
SPRING_DATA_REDIS_PORT=6379

# ── Storage (MinIO) ────────────────────────────────────────────────────────
MINIO_ROOT_USER=redadmin
MINIO_ROOT_PASSWORD=redsecret123
RED_STORAGE_ENDPOINT=http://minio:9000

# ── PSTN / Dumin ───────────────────────────────────────────────────────────
RED_DUMIN_BASE_URL=http://192.168.1.100:5060
RED_DUMIN_API_TOKEN=
